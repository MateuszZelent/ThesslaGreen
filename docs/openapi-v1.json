  "components": {
    "schemas": {
      "CommandRequest": {
        "properties": {
          "type": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Type"
          },
          "parameters": {
            "type": "object",
            "title": "Parameters"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Id"
          },
          "expected_revision": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Expected Revision"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "type"
        ],
        "title": "CommandRequest",
        "description": "One typed, idempotent command submitted by an adapter."
      },
      "CommandResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "confirmed",
            "title": "Status"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Id"
          },
          "replayed": {
            "type": "boolean",
            "title": "Replayed",
            "default": false
          },
          "result": {
            "type": "object",
            "title": "Result"
          },
          "state": {
            "type": "object",
            "title": "State"
          }
        },
        "type": "object",
        "required": [
          "status",
          "result",
          "state"
        ],
        "title": "CommandResponse",
        "description": "Confirmed state returned after a command or its idempotent replay."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
