THESSLA_TRANSPORT=serial
# Prefer the stable /dev/serial/by-id/... path for USB-RS485 adapters.
THESSLA_SERIAL_PORT=
THESSLA_BAUDRATE=9600
THESSLA_BYTESIZE=8
THESSLA_PARITY=N
THESSLA_STOPBITS=1
# Optional explicit Modbus-TCP host; leave empty for serial-only discovery.
THESSLA_HOST=
THESSLA_MODBUS_PORT=502
THESSLA_PORT=8899
THESSLA_DEVICE_ID=10
# Discovery is read-only. Keep additional candidates explicit and bounded.
THESSLA_DISCOVERY_DEVICE_IDS=10
THESSLA_DISCOVERY_BAUDS=9600
THESSLA_DISCOVERY_HOSTS=
THESSLA_DISCOVERY_CIDRS=
THESSLA_DISCOVERY_PORTS=502,8899
THESSLA_DISCOVERY_TIMEOUT_SECONDS=1.0
THESSLA_DISCOVERY_MAX_HOSTS=256
THESSLA_POLL_INTERVAL_SECONDS=5
# Optional delayed physical-response sampling after a confirmed write. Zero keeps command replies immediate.
THESSLA_AIRFLOW_OBSERVATION_SECONDS=0
THESSLA_AIRFLOW_OBSERVATION_INTERVAL_SECONDS=1
THESSLA_DATABASE_URL=sqlite:///./thessla.db
THESSLA_TELEMETRY_RETENTION_ROWS=10000
THESSLA_AUDIT_RETENTION_ROWS=5000
# Idempotency records survive gateway restart and expire after this many seconds.
THESSLA_COMMAND_CACHE_RETENTION_ROWS=256
THESSLA_COMMAND_CACHE_TTL_SECONDS=86400
THESSLA_API_BIND=127.0.0.1
THESSLA_API_PORT=8000
# Optional bearer token required by the FastAPI gateway and HACS adapter.
THESSLA_API_TOKEN=
# Optional explicit browser origins, comma-separated. Empty means no cross-origin browser access.
THESSLA_API_CORS_ORIGINS=
